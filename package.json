{
  "name": "viewx-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "tsc -b && vite build",
    "start": "dotnet run --project server/ViewX.Server.csproj --no-launch-profile -- --urls http://localhost:3000",
    "test": "node --test tests/model.test.mjs tests/data.test.mjs tests/advanced.test.mjs tests/screens.test.mjs tests/global-alarms.test.mjs tests/communication.test.mjs",
    "test:browser": "npm run build:server && node tests/browser.mjs",
    "format": "prettier --write src scripts tests/*.mjs *.json *.ts index.html README.md",
    "dev:server": "dotnet run --project server/ViewX.Server.csproj",
    "build:server": "dotnet build server/ViewX.Server.csproj",
    "test:server": "dotnet test tests/ViewX.Server.Tests/ViewX.Server.Tests.csproj",
    "test:api": "npm run build:server && node tests/api.mjs",
    "publish:server": "dotnet publish server/ViewX.Server.csproj -c Release -o artifacts/server",
    "test:dev": "npm run build:server && node tests/dev.mjs",
    "test:widgets": "npm run build:server && node tests/widgets.mjs",
    "test:interactions": "npm run build:server && node tests/interactions.mjs",
    "test:advanced": "npm run build:server && node tests/advanced-browser.mjs",
    "test:management": "npm run build:server && node tests/management.mjs",
    "test:screens": "npm run build:server && node tests/screens-browser.mjs",
    "test:alarms": "npm run build:server && node tests/alarms-browser.mjs",
    "test:communication": "npm run build:server && node tests/communication-browser.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  }
}
